{
  "name": "create-stackjet",
  "version": "0.0.0",
  "description": "A production-ready Expo stack in one command.",
  "type": "module",
  "bin": {
    "create-stackjet": "./dist/cli.js",
    "stackjet": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "latest",
    "@stackjet/brand": "workspace:*",
    "@stackjet/core": "workspace:*",
    "@stackjet/schemas": "workspace:*",
    "@stackjet/sdk-57": "workspace:*",
    "commander": "latest",
    "execa": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "~6.0.3",
    "vitest": "latest"
  }
}
