{
  "name": "create-expojet",
  "version": "0.7.0",
  "description": "A production-ready Expo stack in one command.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-expojet": "./dist/cli.js",
    "expojet": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./generation": "./dist/generation.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "latest",
    "commander": "latest",
    "execa": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@expojet/adapters": "workspace:*",
    "@expojet/brand": "workspace:*",
    "@expojet/core": "workspace:*",
    "@expojet/schemas": "workspace:*",
    "@expojet/sdk-57": "workspace:*",
    "@types/node": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "~6.0.3",
    "vitest": "latest"
  }
}
