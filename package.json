{
  "name": "stackjet",
  "version": "0.0.0",
  "private": true,
  "description": "A production-ready Expo stack in one command.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "check": "biome check . && turbo typecheck test",
    "format": "biome check --write .",
    "sdk:check": "node scripts/sync-sdk-pack.mjs --check",
    "sdk:sync": "node scripts/sync-sdk-pack.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "latest",
    "turbo": "latest",
    "typescript": "~6.0.3"
  }
}
