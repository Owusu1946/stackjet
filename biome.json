{
  "files": {
    "includes": [
      "packages/**",
      "apps/**",
      "!packages/**/dist",
      "!packages/sdk-packs/**/pack.json",
      "!packages/sdk-packs/**/src/template.generated.ts",
      "!apps/**/node_modules",
      "!apps/**/.next",
      "*.json",
      "*.jsonc",
      "*.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "overrides": [
    {
      "includes": ["apps/docs/public/stack-icons/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
